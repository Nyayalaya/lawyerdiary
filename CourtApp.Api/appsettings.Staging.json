{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}"
        }
      },
      {
        "Name": "RollingFile",
        "Args": {
          "pathFormat": "Logs/api-staging-{Date}.log",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}",
          "fileSizeLimitBytes": 52428800,
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Properties": {
      "Application": "CourtApp.Api",
      "Environment": "Staging"
    }
  },
  "ConnectionStrings": {
    "Postgres": "CONFIGURE_YOUR_STAGING_DATABASE_CONNECTION_STRING",
    "SqlServer": "CONFIGURE_YOUR_STAGING_DATABASE_CONNECTION_STRING"
  },
  "JWTSettings": {
    "DurationInMinutes": 120
  },
  "UploadSettings": {
    "Provider": "GoogleDrive"
  },
  "DatabaseProvider": "Postgres",
  "UseInMemoryDatabase": false,
  "AllowedHosts": "api-staging.yourdomain.com"
}
