@* Case Information Partial View *@
<div class="case-info-container">
    <h2>Case Information Summary</h2>
    <table class="case-info-table">
        <thead>
            <tr>
                <th>Field Name</th>
                <th>Tag</th>
                <th>Field Name</th>
                <th>Tag</th>
                <th>Field Name</th>
                <th>Tag</th>
            </tr>
        </thead>
        <tbody>
            @* <tr class="section-header">
                <td colspan="6">Basic Case Informatio</td>
            </tr> *@
            <tr>
                <td>Institution Date</td>
                <td>#InstitutionDate#</td>
                <td>State Name</td>
                <td>#StateName#</td>
                <td>Court Type</td>
                <td>#CourtType#</td>
            </tr>
            <tr>
                <td>Court District</td>
                <td>#CourtDistrict#</td>
                <td>Court Complex</td>
                <td>#CourtComplex#</td>
                <td>Court</td>
                <td>#Court#</td>
            </tr>
            <tr>
                <td>Case No/Year</td>
                <td>#CaseNoYear#</td>
                <td>Case Category</td>
                <td>#CaseCategory#</td>
                <td>Case Type</td>
                <td>#CaseType#</td>
            </tr>
            <tr>
                <td>CIS No/Year</td>
                <td>#CisNoYear#</td>
                <td>Petitioner</td>
                <td>#Petitioner#</td>
                <td>Respondent</td>
                <td>#Respondant#</td>
            </tr>
            <tr>
                <td>Petitioner Appearance</td>
                <td>#PetitionerAppearance#</td>
                <td>Respondent Appearance</td>
                <td>#RespondantAppearance#</td>
                <td>Next Date</td>
                <td>#NextDate#</td>
            </tr>
            <tr>
                <td>Case Stage</td>
                <td>#CaseStage#</td>
                <td>Disposal Date</td>
                <td>#DisposalDate#</td>
                <td>CNR No</td>
                <td>#CnrNo#</td>
            </tr>
            <tr>
                <td>Strength</td>
                <td>#Strength#</td>
                <td>Decision Date</td>
                <td>#DecisionDate#</td>
            </tr>
            <tr>
                <td>First Party Detail</td>
                <td>#FirstPartyDetail#</td>
                <td>Second Party (Applicant No)</td>
                <td>#ApplicantNo#</td>
                <td>Second Party Detail</td>
                <td>#ApplicantDetail#</td>
            </tr>

            @* <tr class="section-header">
                <td colspan="6">Against Party Information</td>
            </tr> *@
            <tr>
                <td>Impugned Order</td>
                <td>#ImpugedOrder#</td>
                <td>Against State</td>
                <td>#AgState#</td>
                <td>Against Court Type</td>
                <td>#AgCourtType#</td>
            </tr>
            <tr>
                <td>Against Court District</td>
                <td>#AgCourtDistrict#</td>
                <td>Against Court Complex</td>
                <td>#AgCourtComplex#</td>
                <td>Against Court Bench</td>
                <td>#AgCourtBench#</td>
            </tr>
            <tr>
                <td>Against Case Category</td>
                <td>#AgCaseCategory#</td>
                <td>Against Case Type</td>
                <td>#AgCaseType#</td>
                <td>Against Case No/Year</td>
                <td>#AgCaseNoYear#</td>
            </tr>
            <tr>
                <td>Against Cis No</td>
                <td>#AgCisNo#</td>
                <td>Against Cnr No</td>
                <td>#AgCnrNo#</td>
                <td>Against Cis No Year</td>
                <td>#AgCisNoYear#</td>
            </tr>
            <tr>
                <td>Officer Name</td>
                <td>#OfficerName#</td>
                <td>Cadre</td>
                <td>#Cadre#</td>
                <td>Current Date</td>
                <td>#CurrentDate#</td>
            </tr>

            <tr>
                <td>Lawyer Name</td>
                <td>#LawyerName#</td>
                <td>Lawyer Mobile</td>
                <td>#LawyerMobile#</td>
                <td>Lawyer Address</td>
                <td>#LawyerAddress#</td>
            </tr>
            <tr>
                <td>Lawyer Email</td>
                <td>#LawyerEmail#</td>
                <td>Lawyer Enrollment</td>
                <td>#LawyerEnrollment#</td>                
            </tr>
        </tbody>
    </table>
</div>

<style>
    .case-info-container {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f8f9fa;
        border-radius: 5px;
    }

        .case-info-container h2 {
            text-align: center;
            color: #2c3e50;
            margin-bottom: 5px;
        }

        .case-info-container .subtitle {
            text-align: center;
            color: #7f8c8d;
            margin-bottom: 15px;
            font-size: 14px;
        }

    .case-info-table {
        width: 100%;
        border-collapse: collapse;
        background-color: #fff;
        border: 1px solid #dee2e6;
    }

        .case-info-table th,
        .case-info-table td {
            border: 1px solid #dee2e6;
            padding: 8px 10px;
            text-align: left;
        }

        .case-info-table th {
            background-color: #2c3e50;
            color: white;
            text-align: center;
            font-weight: 600;
        }

        .case-info-table tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        .case-info-table td:first-child {
            width: 15%;
            font-weight: 500;
            color: #2c3e50;
        }

        .case-info-table td:nth-child(2n) {
            color: #7f8c8d;
        }

        .case-info-table .section-header {
            background-color: #34495e;
            color: #fff;
            font-weight: bold;
            text-align: center;
        }
</style>
