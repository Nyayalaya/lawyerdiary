@{
    ViewData["Title"] = localizer["Lawyer Dashboard"];
}
@model DashboardViewModel
@using Newtonsoft.Json

<link href="~/css/dashboard.css" rel="stylesheet" />
@if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
{
    <div class="container-fluid">
        <div class="row">
            Coming soon!
            

        </div>
    </div>
}
else
{
    <div class="container py-4">
        <div class="row g-3">
            <div class="col-md-2">
                <div class="card-summary blue text-center">Total Cases<br><span class="fs-3">@Model.TotalCases</span></div>
            </div>
            <div class="col-md-2">
                <div class="card-summary cyan text-center">Pending Cases<br><span class="fs-3">@Model.PendingCases</span></div>
            </div>
            <div class="col-md-2">
                <div class="card-summary teal text-center">Disposed Cases<br><span class="fs-3">@Model.DisposedCases</span></div>
            </div>
            <div class="col-md-2">
                <div class="card-summary orange text-center">Assigned Cases<br><span class="fs-3">@Model.AssignedCases</span></div>
            </div>
            <div class="col-md-2">
                <div class="card-summary red text-center">Today's Hearing<br><span class="fs-3">@Model.TodayHearing</span></div>
            </div>
            <div class="col-md-2">
                <div class="d-flex flex-column gap-2">
                    <a onclick="jQueryModalGet('/client/manageclient/CreateOrEdit','Add New Client')"
                       class="btn bg-primary w-100">
                        <i class="fa fa-plus-square"></i> Add Client
                    </a>
                    <a asp-area="Litigation" asp-controller="CaseManage"
                       asp-action="CreateOrUpdate" class="btn bg-success w-100">
                        <i class="fa fa-plus-square"></i> Add New Case
                    </a>

                </div>
            </div>

        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <h5 class="section-title">Cases vs Disposed Cases</h5>
                <canvas id="barChart" style="width: 100%; height: 100%;"></canvas>
            </div>
            <div class="col-md-6">
                <h5 class="section-title">Case Status Distribution  (Total Cases: @Model.TotalCases)</h5>
                <canvas id="pieChart" style="width: 100%; height: 100%;"></canvas>
            </div>
        </div>

        <div class="row mt-4">
            @* <div class="col-md-6">
                <h5 class="section-title">Top Clients</h5>
                <table class="table table-bordered">
                    <thead><tr><th>Client</th><th>Cases</th><th>Next Hearing</th></tr></thead>
                    <tbody>
                        <tr><td>Acme Inc</td><td>5</td><td>Apr 22</td></tr>
                        <tr><td>State v. John</td><td>4</td><td>Apr 18</td></tr>
                        <tr><td>Jones & Roe</td><td>3</td><td>Apr 15</td></tr>
                    </tbody>
                </table>
                <button class="btn add-case-btn">+ Add Case</button>
            </div> *@
            @* <div class="col-md-6">
                <h5 class="section-title">Upcoming Hearings</h5>
                <input type="text" id="calendarInput" class="form-control" placeholder="Select Date" style="width: 100%;" />
                <div id="calendarInline"></div>
            </div> *@
        </div>

        
    </div>

}
@section Scripts
{
    <script>
        window.monthlyCaseData = @Html.Raw(Json.Serialize(Model.MonthlyCaseStatuses));
        window.caseStatusData = @Html.Raw(Json.Serialize(Model.StatusSummaries));
        window.hearingDates = @Html.Raw(Json.Serialize(Model.UpcomingHearings));
    </script>
    <script src="~/js/Dashboard.js"></script>
}