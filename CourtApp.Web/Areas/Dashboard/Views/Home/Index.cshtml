@{
    ViewData["Title"] = localizer["Lawyer Dashboard"];    
}
@model DashboardViewModel
@using Newtonsoft.Json

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', sans-serif;
    }

    .card-button {
        border-radius: 10px;
    }

    .card-summary {
        color: white;
        padding: 20px;
        border-radius: 10px;
        font-weight: bold;
    }

        .card-summary.blue {
            background-color: #007bff;
        }

        .card-summary.orange {
            background-color: #fd7e14;
        }

        .card-summary.teal {
            background-color: #20c997;
        }

        .card-summary.cyan {
            background-color: #17a2b8;
        }

        .card-summary.red {
            background-color: red;
        }

        .card-summary.yellow {
            background-color: greenyellow;
        }

    .section-title {
        font-weight: 600;
        margin-bottom: 10px;
    }

    .add-case-btn {
        background-color: #007bff;
        color: white;
        border: none;
    }
</style>
@if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
{
    <div class="container-fluid">
        <div class="row">
            Coming soon!
            @* <div class="col-sm-4">
                <div class="card border-primary">
                    <div class="card-header text-uppercase text-center"><strong>today's hearing</strong></div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-10 text-uppercase text-left">total cases</div>
                            <div class="col-md-2 font-weight-bolder bg-orange text-center">9</div>
                        </div>
                        <div class="row" style="margin-block:auto">
                            <div class="col-md-10 text-uppercase text-left">pending cases</div>
                            <div class="col-md-2 font-weight-bolder bg-lightblue text-center">9</div>
                        </div>
                        <div class="row">
