                        </div>
                        <div class="row" style="margin-block:auto">
                            <div class="col-md-10 text-uppercase text-left">new cases</div>
                            <div class="col-md-2 font-weight-bolder bg-lightblue text-center">9</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card border-primary">
                    <div class="card-header text-uppercase text-center"><strong>Cases</strong></div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-10 text-uppercase text-left">total cases</div>
                            <div class="col-md-2 font-weight-bolder bg-orange text-center">9</div>
                        </div>
                        <div class="row" style="margin-block:auto">
                            <div class="col-md-10 text-uppercase text-left">pending cases</div>
                            <div class="col-md-2 font-weight-bolder bg-lightblue text-center">9</div>
                        </div>
                        <div class="row">
                            <div class="col-md-10 text-uppercase text-left">closed cases</div>
                            <div class="col-md-2 font-weight-bolder bg-gradient-red text-center">9</div>
                        </div>
                    </div>
                </div>
            </div> *@

        </div>
    </div>
}
else
{
    <div class="container py-4">
        <div class="row g-3">
            <div class="col-md-2">
                <div class="card-summary blue text-center">Total Cases<br><span class="fs-3">@Model.TotalCases</span></div>
            </div>
            <div class="col-md-2">
                <div class="card-summary cyan text-center">Pending Cases<br><span class="fs-3">@Model.PendingCases</span></div>
            </div>
            <div class="col-md-2">
                <div class="card-summary teal text-center">Disposed Cases<br><span class="fs-3">@Model.DisposedCases</span></div>
            </div>
            <div class="col-md-2">
                <div class="card-summary orange text-center">Assigned Cases<br><span class="fs-3">@Model.AssignedCases</span></div>
            </div>
            <div class="col-md-2">
                <div class="card-summary red text-center">Today's Hearing<br><span class="fs-3">@Model.TodayHearing</span></div>
            </div>
            <div class="col-md-2">
                <div class="d-flex flex-column gap-2">                   
                    <a onclick="jQueryModalGet('/client/manageclient/CreateOrEdit','Add New Client')"
                       class="btn bg-primary w-100">
                        <i class="fa fa-plus-square"></i> Add Client
                    </a>
                    <a asp-area="Litigation" asp-controller="CaseManage"
                       asp-action="CreateOrUpdate" class="btn bg-success w-100">
                        <i class="fa fa-plus-square"></i> Add New Case
                    </a>

                </div>
            </div>

        </div>

        <div class="row mt-4">
            <div class="col-md-6" >
                <h5 class="section-title">Cases vs Disposed Cases</h5>
                <canvas id="barChart" style="width: 100%; height: 100%;"></canvas>
            </div>
            <div class="col-md-6">
                <h5 class="section-title">Case Status Distribution  (Total Cases: @Model.TotalCases)</h5>
                <canvas id="pieChart" style="width: 100%; height: 100%;"></canvas>
            </div>
        </div>

        <div class="row mt-4">
            @* <div class="col-md-6">
                <h5 class="section-title">Top Clients</h5>
                <table class="table table-bordered">
                    <thead><tr><th>Client</th><th>Cases</th><th>Next Hearing</th></tr></thead>
                    <tbody>
