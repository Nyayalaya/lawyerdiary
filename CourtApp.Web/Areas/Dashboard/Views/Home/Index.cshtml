                        <tr><td>State v. John</td><td>4</td><td>Apr 18</td></tr>
                        <tr><td>Jones & Roe</td><td>3</td><td>Apr 15</td></tr>
                    </tbody>
                </table>
                <button class="btn add-case-btn">+ Add Case</button>
            </div> *@
            @* <div class="col-md-6">
                <h5 class="section-title">Upcoming Hearings</h5>
                <input type="text" id="calendarInput" class="form-control" placeholder="Select Date" style="width: 100%;" />
                <div id="calendarInline"></div>
            </div> *@
        </div>

        @* <div class="row mt-4">

            <div class="col-md-6">
                <h5 class="section-title">Pending Work</h5>
                <table class="table table-bordered">
                    <thead><tr><th>Case ID</th><th>Task</th><th>Due Date</th></tr></thead>
                    <tbody>
                        <tr><td>PQR v. Davis</td><td>Draft Motion</td><td>Apr 25</td></tr>
                        <tr><td>GHI v. Brown</td><td>Review Docs</td><td>Apr 24</td></tr>
                        <tr><td>LMN v. Doe</td><td>Draft Motion</td><td>Apr 19</td></tr>
                    </tbody>
                </table>
            </div>
        </div> *@
    </div>

}
@section Scripts
{    
    <script>
        window.monthlyCaseData = @Html.Raw(Json.Serialize(Model.MonthlyCaseStatuses));
        window.caseStatusData = @Html.Raw(Json.Serialize(Model.StatusSummaries));
        window.hearingDates = @Html.Raw(Json.Serialize(Model.UpcomingHearings));
    </script>
    <script src="~/js/Dashboard.js"></script>
}