@{
    ViewData["Title"] = localizer["User Case List"];
}

@Html.AntiForgeryToken()
<div class="card shadow">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        @if (AuthorizationService.AuthorizeAsync(User, "CasePanel.ManageCase.Create").Result.Succeeded)
        {
            <a asp-area="Litigation" asp-controller="CaseManage" asp-action="CreateOrUpdate" class="btn btn-primary btn-sm">
                <i class="fa fa-plus-square"></i> Add New Case
            </a>
        }
        <a id="reload" class="btn btn-secondary btn-sm mr-2">
            <i class="fa fas fa-bolt"></i>
            Reload
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="tblUserCase" class="table table-striped table-bordered" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th style="width:1%!important">Sno.</th>
                        <th style="width:10%!important">Reference</th>
                        <th style="width:16%!important">Court</th>
                        <th style="width:16%!important">Type</th>
                        <th style="width:5%!important">No.</th>
                        <th style="width:5%!important">Year</th>
                        <th style="width:30%!important">Title</th>
                        <th style="width:10%!important">Stage</th>
                        <th style="width:14%!important">Next Date</th>
                        <th style="width:3%!important">Actions</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
@section Scripts
{
    <script>
                function deleteCase(caseId) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {

                    $.ajax({
                        url: '/Litigation/CaseManage/DeleteCase',
                        type: 'POST',
                        data: { id: caseId },
                        success: function (response) {
                            if (response.succeeded) {

                                // ✅ Toast on success
                                Swal.fire({
                                    toast: true,
                                    icon: 'success',
                                    title: response.message,
                                    position: 'top-end',
                                    showConfirmButton: false,
                                    timer: 2000,
                                    timerProgressBar: true
                                });

                                // 🔄 Reload DataTable
                                $('#tblUserCase').DataTable().ajax.reload(null, false);
                            }
                            else {
                                // ❌ Toast on failure
                                Swal.fire({
                                    toast: true,
                                    icon: 'error',
                                    title: response.message || 'Failed to delete case.',
                                    position: 'top-end',
                                    showConfirmButton: false,
                                    timer: 2500,
                                    timerProgressBar: true
                                });
                            }
                        },
                        error: function () {
                            Swal.fire({
                                toast: true,
                                icon: 'error',
                                title: 'Error occurred while deleting the case.',
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 2500,
                                timerProgressBar: true
                            });
                        }
                    });
                }
            });
        }

        $(document).ready(function () {
            const addUrl = "/Litigation/CaseManage/CreateOrUpdate";
            JqueryDataTable("tblUserCase", {
                ajaxUrl: '/Litigation/CaseManage/LoadAll',
                addUrl: addUrl,
                serverSide: true,
                columns: [
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        },
                        orderable: false
                    },
                    { data: "Reference",orderable: false },
                    { data: "Court",orderable: false },
                    { data: "CaseType",orderable: false },
                    { data: "No",orderable: false },
                    { data: "Year" ,orderable: false},
                    { data: "CaseDetail" ,orderable: false},
                    { data: "CaseStage",orderable: false },
                    { data: "NextDate",orderable: false },
                    { data: "ActionHtml", orderable: false, searchable: false }
                ],
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="fas fa-file-excel"></i> Export',
                        className: 'btn btn-outline-warning me-2',
                        exportOptions: {
                            modifier: { page: 'all' },
                            columns: ':not(:last-child)'
                        }
                    }
                ]
            });



        });

    </script>
}
