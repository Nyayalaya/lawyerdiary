@using System.Globalization
@model IEnumerable<GetCaseInfoViewModel>
@{
    ViewData["Title"] = localizer["Case List Without Next Date"];
    ViewData["Caption"] = localizer["You can fill hearing date from here"];
    ViewData["Note"] = localizer["All (*) marked date will default today date. There is no next date present in database "];
}
<div class="card">
    <div class="col-sm-12" style="padding:20px">
        <table id="tblCaseWohd" class="table table-striped" width="100%" cellspacing="0">
            <thead>
                <tr>
                    <th style="width:5%!important">Sno.</th>
                    <th style="width:10%!important">Court</th>
                    <th style="width:10%!important">Type</th>
                    <th style="width:5%!important">No.</th>
                    <th style="width:5%!important">Year</th>
                    <th style="width:25%!important">Title</th>
                    <th style="width:10%!important">Stage</th>
                    <th style="width:15%!important">Last Proceeding Date</th>
                    <th style="width:15%!important">Next Date</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int count = 0;
                }
                @foreach (var bt in Model)
                {
                    <tr>
                        <td>
                            @(count = count + 1)
                        </td>
                        <td>
                            @bt.Court.ToUpper()
                        </td>
                        <td>
                            @bt.CaseType.ToUpper()
                        </td>
                        <td>
                            @bt.No
                        </td>
                        <td>
                            @bt.Year
                        </td>
                        <td>
                            @bt.CaseDetail.ToUpper()<br />
                            <small>
                                @if (bt.IsCaseHavingChild)
                                {
                                    <span class="badge badge-success">@localizer["Parent Case"]</span>
                                }
                            </small>
                        </td>
                        <td>
                            @bt.CaseStage.ToUpper()
                        </td>
                        <td>
                            @bt.ProceedingDate
                        </td>
                        <td>
                            @{
                                DateTime? ndt = null;
                                if (!string.IsNullOrWhiteSpace(bt.NextDate) && bt.NextDate != "-infinity")
                                {
                                    ndt = DateTime.ParseExact(bt.NextDate, "dd/MM/yyyy", CultureInfo.InvariantCulture);
                                }
                            }
                            <input type="date"
                                   value="@(ndt != DateTime.MinValue ? ndt?.ToString("yyyy-MM-dd") : "")"
                                   class="form-control next-date"
                                   data-original-next="@ndt?.ToString("yyyy-MM-dd")" />
                            <input type="hidden" name="ProceedingDate" value="@bt.ProceedingDate" />
                            <input type="hidden" name="CaseId" value="@bt.Id" />
                            <input type="hidden" name="IsParent" value="@bt.IsCaseHavingChild.ToString()" />
                            @if (ndt == null || ndt==DateTime.MinValue)
                            {
                                <span style="color:red">*</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.Count() > 0)
        {
            <div class="form-group justify-content-between" style="margin-bottom: 0px !important">
                <input type="button" id="btnUpdate" class="btn btn-success" value="Update" />
            </div>
        }
    </div>
</div>
@section Scripts
{   
    <script src="~/js/Litigation/CaseHearingDate.js"></script>
}
