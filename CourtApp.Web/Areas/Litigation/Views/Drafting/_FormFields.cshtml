@model FormBuilderViewModel

<style>
    .lang-input {
        font-family: "Kruti Dev 010", "Mangal", "Arial Unicode MS", sans-serif;
        font-size: 18px;
        line-height: 1.8;
    }

        .lang-input:focus {
            border-color: #4CAF50;
            box-shadow: 0 0 0 0.2rem rgba(76, 175, 80, 0.25);
        }

    .lang-english {
        font-family: Arial, Helvetica, sans-serif !important;
    }

    .help-box {
        background: #e7f3ff;
        border-left: 4px solid #2196F3;
        padding: 12px 15px;
        margin-bottom: 15px;
        border-radius: 4px;
    }
</style>

<div id="viewAll" class="card-body table-responsive">

    <!-- Language Radio Buttons -->
    <div class="row align-items-center mb-3">
        <div class="col-auto">
            <label>
                <input type="radio" name="LangCode" value="en"
                       @(Model.LangCode == "en" ? "checked" : "") /> English
            </label>
        </div>
        <div class="col-auto">
            <label>
                <input type="radio" name="LangCode" value="hi"
                       @(Model.LangCode == "hi" ? "checked" : "") /> हिंदी
            </label>
        </div>
    </div>

    <!-- Table -->
    <div class="row">
        <table id="tblRegister" class="table table-striped" style="border:1px;">
            <thead>
                <tr>
                    <th style="width:5%">Sno.</th>
                    <th style="width:25%">Label Name</th>
                    <th style="width:70%">Value</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.FieldDetails.Count() > 0)
                {
                    int count = 0;
                    for (int i = 0; i < Model.FieldDetails.Count(); i++)
                    {
                        <tr>
                            <td>
                                <input type="hidden" asp-for="@Model.FieldDetails[i].Tag" />
                                <label class="col-form-label">@(++count)</label>
                            </td>
                            <td>
                                <input type="hidden" asp-for="@Model.FieldDetails[i].Name" />
                                <label class="col-form-label">@localizer[@Model.FieldDetails[i].Name]</label>
                            </td>
                            <td>
                                <input type="hidden" asp-for="@Model.FieldDetails[i].Type" />
                                @if (@Model.FieldDetails[i].Type == "1")
                                {
                                    <input class="form-control"
                                           type="text"
                                           id="field_@i"
                                           asp-for="@Model.FieldDetails[i].Value" />
                                }
                                else if (@Model.FieldDetails[i].Type == "2")
                                {
                                    <input type="date" asp-for="@Model.FieldDetails[i].Value" class="form-control">
                                }
                                else if (@Model.FieldDetails[i].Type == "4")
                                {
                                    <textarea asp-for="@Model.FieldDetails[i].Value" class="form-control"></textarea>
                                }
                                else if (@Model.FieldDetails[i].Type == "5")
                                {
                                    <input class="form-control" type="number" asp-for="@Model.FieldDetails[i].Value" />
                                }
                                else
                                {
                                    if (@Model.FieldDetails[i].DefaultVal != null)
                                    {
                                        var ddlValues = @Model.FieldDetails[i].DefaultVal.Split(',').ToList();
                                        var selectListItems = ddlValues.Select(x => new SelectListItem { Text = x, Value = x });
                                        <select asp-for="@Model.FieldDetails[i].Value" asp-items="@(new SelectList(selectListItems, "Value", "Text"))" class="form-control" title="Please select the value!">
                                            <option>--Select--</option>
                                        </select>
                                    }
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" align="center">Record is not there</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script src="~/js/krutidevtounicode.js"></script>

<script>
    $(document).ready(function () {

        var isHindiMode = $('input[name="LangCode"]:checked').val() === 'hi';
        var isConverting = false;

        // Language toggle
        $('input[name="LangCode"]').on('change', function () {
            isHindiMode = this.value === 'hi';
            $('.lang-input').toggleClass('lang-english', !isHindiMode);
        });

        // Detect KrutiDev characters (ASCII-based)
        function containsKruti(text) {
            return /[A-Za-z\[\]\+\\\^\~\`\{\}]/.test(text);
        }

        // Live KrutiDev → Unicode
        $('.lang-input').on('input', function () {

            if (!isHindiMode || isConverting) return;

            var $this = $(this);
            var originalText = $this.val();

            // Convert ONLY if Kruti characters exist
            if (!containsKruti(originalText)) return;

            isConverting = true;

            // Preserve cursor position
            var cursorPos = this.selectionStart;

            var converted = krutiDevToUnicode(originalText);

            $this.val(converted);

            // Restore cursor position (best effort)
            this.setSelectionRange(cursorPos, cursorPos);

            isConverting = false;
        });

        // Ensure Unicode is posted (SAFE)
        $('#viewAll').closest('form').on('submit', function () {

            if (!isHindiMode) return;

            $('.lang-input').each(function () {
                var val = $(this).val();

                // Convert ONLY if still KrutiDev
                if (containsKruti(val)) {
                    $(this).val(krutiDevToUnicode(val));
                }
            });
        });
    });
</script>

