@model BringTodayCaseViewModel
<style>
    .custom-green td {
        color: green !important;
        background-color: honeydew !important;
    }
</style>
<div class="card">
    <div id="viewAll" class="card-body table-responsive">
        <form asp-controller="Hearing" method="post" asp-action="AssignWorkCase" class="d-inline">
            <div class="row">
                <div class="col-md-12">
                    <div class="mb-3" id="customTableActions">
                    </div>
                    <table id="tblTHearingCaseDetail" class="table table-striped" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Sno.</th>
                                <th>Reference</th>
                                <th>Court</th>
                                <th>Type</th>
                                <th>Number</th>
                                <th>Year</th>
                                <th>Stage</th>
                                <th>Title</th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int count = 0;
                                string col = "";
                            }
                            @for (int i = 0; i < Model.CaseList.Count(); i++)
                            {
                                @if (@Model.CaseList[i].IsProceedingDone)
                                {
                                    col = "green";
                                }
                                else col = "";
                                <tr class="@(Model.CaseList[i].IsProceedingDone ? "custom-green" : "")">
                                    <td style="width:5%">
                                        <input type="hidden" asp-for="@Model.CaseList[i].Id" />
                                        @(count = count + 1)
                                    </td>
                                    <td>@Model.CaseList[i].Reference</td>
                                    <td style="width:10%">
                                        <input type="hidden" asp-for="@Model.CaseList[i].CourtName" />
                                        @Model.CaseList[i].CourtName
                                    </td>
                                    <td style="width:10%">
                                        <input type="hidden" asp-for="@Model.CaseList[i].CaseTypeName" />
                                        @Model.CaseList[i].CaseTypeName
                                    </td>
                                    <td style="width:10%">
                                        <input type="hidden" asp-for="@Model.CaseList[i].CaseNumber" />
                                        @Model.CaseList[i].CaseNumber
                                        <small>
                                            @if (Model.CaseList[i].HasChild)
                                            {
                                                <span class="badge badge-success">@localizer["Parent Case"]</span>
                                            }
                                        </small>
                                    </td>
                                    <td style="width:5%">
                                        <input type="hidden" asp-for="@Model.CaseList[i].CaseYear" />
                                        @Model.CaseList[i].CaseYear
                                    </td>
                                    <td style="width:5%">
                                        <input type="hidden" asp-for="@Model.CaseList[i].CaseStage" />
                                        @Model.CaseList[i].CaseStage
                                    </td>
                                    <td style="width:35%">
                                        <input type="hidden" asp-for="@Model.CaseList[i].CaseTitle" />
                                        @Model.CaseList[i].CaseTitle
                                    </td>
                                    <td>
                                        <div class="form-check m-1">
                                            @if (!Model.CaseList[i].HasChild)
                                            {
                                                <input asp-for="@Model.CaseList[i].Selected" class="form-check-input" />
                                            }
                                        </div>
                                    </td>
                                    <td class="text-right">
                                        @{
                                            var actionModel = new CaseActionViewModel();
                                            actionModel.CaseId = @Model.CaseList[i].Id;
                                            actionModel.Reference = @Model.CaseList[i].Reference;
                                            actionModel.IsCaseAssigned = @Model.CaseList[i].IsCaseAssigned;
                                        }
                                        <partial name="_CaseGroupActionPartial" model="@actionModel"></partial>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </form>
    </div>
</div>
<script>
        $(document).ready(function () {

        var table = $('#tblTHearingCaseDetail').DataTable({
            paging: true,
            searching: true,
            ordering: false,
            pageLength: 10,
            lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
            language: {
                emptyTable: "No cases found.",
                lengthMenu: "Show _MENU_ entries",
                search: "Search:"
            }
        });

        // ✅ Persistent storage for selected IDs
        var selectedCaseIds = new Set();

        // 🔹 Checkbox change event — works for all pages via event delegation
        $('#tblTHearingCaseDetail').on('change', 'input[type="checkbox"]', function () {
            var caseId = $(this).closest("tr").find("input[type='hidden'][name*='.Id']").val();
            if ($(this).is(':checked')) {
                selectedCaseIds.add(caseId);
            } else {
                selectedCaseIds.delete(caseId);
            }
        });

        // 🔹 Restore checked state when table redraws (pagination/search)
        table.on('draw', function () {
            $('#tblTHearingCaseDetail input[type="checkbox"]').each(function () {
                var caseId = $(this).closest("tr").find("input[type='hidden'][name*='.Id']").val();
                $(this).prop('checked', selectedCaseIds.has(caseId));
            });
        });

        // ✅ Function to get all selected IDs
        function getSelectedCaseIds() {
            return Array.from(selectedCaseIds);
        }

        // 🔹 Buttons
        var bringTodatBtn = $('<button class="btn btn-sm btn-success mr-2"><i class="fa fa-calendar"></i> Bring Today</button>');
        var exportBtn = $('<button class="btn btn-sm btn-outline-success mr-2">Export to Excel</button>');
        var updateBtn = $('<button class="btn btn-sm btn-outline-primary">Update Common Proceeding</button>');

        bringTodatBtn.on('click', function (event) {
            event.preventDefault();
            jQueryModalGet('/Litigation/hearing/GetCaseHearing', 'Bring Today');
        });

        exportBtn.on('click', function (event) {
            event.preventDefault();
            table.button('.buttons-excel').trigger();
        });

        updateBtn.on('click', function (event) {
            event.preventDefault();
            var ids = getSelectedCaseIds();
            if (ids.length === 0) {
                Swal.fire("Error!", "Please select at least one case.", "error");
                return;
            }
            jQueryModalGet('/Litigation/hearing/BulkProceeding?CaseIds=' + ids.join(','), 'Case Proceedings');
        });

        $('#customTableActions').append(bringTodatBtn, exportBtn, updateBtn);

        new $.fn.dataTable.Buttons(table, {
            buttons: [
                {
                    extend: 'excelHtml5',
                    title: 'Today Case Hearing',
                    filename: 'Today_Case_Hearing_' + new Date().toISOString().split('T')[0],
                    className: 'd-none',
                    exportOptions: {
                        columns: [0, 1, 2, 3, 4, 5, 6]
                    }
                }
            ]
        });

        table.buttons(0, null).container().appendTo(document.body);
    });


</script>
@* <script src="~/js/Litigation/BringToday.js"></script> *@
