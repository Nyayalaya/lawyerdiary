@model List<string>

<style>
    /* Envelope Layout (Portrait) */
    .envelope {
        width: 110mm; /* Envelope width */
        height: 220mm; /* Envelope height */
        margin: 10px auto;
        position: relative;
        box-sizing: border-box;
        border: 1px dashed #ccc; /* Screen preview */
        page-break-after: always;
    }

        .envelope:last-child {
            page-break-after: auto;
        }

    .case-header {
        font-size: 14pt;
        font-weight: bold;
        position: absolute;
        top: 15mm;
        left: 15mm;
    }

    .recipient {
        font-size: 12pt;
        line-height: 1.6;
        position: absolute;
        top: 80mm;
        left: 20mm;
        width: 75mm;
        text-align: left;
    }

    .sender {
        font-size: 10pt;
        line-height: 1.4;
        position: absolute;
        bottom: 15mm;
        left: 15mm;
        width: 80mm;
    }

    /* Razor requires @@ */
    @@media print {
        body, html {
            margin: 0;
            padding: 0;
            font-family: 'Times New Roman', serif;
        }

        .envelope {
            border: none; /* Remove preview border for printing */
        }

        .no-print {
            display: none;
        }

        @@page {
            size: 110mm 220mm; /* Portrait envelope */
            margin: 0;
        }
    }
</style>

<!-- Envelope Area -->
<div id="printableArea">
    @for (int i = 0; i < Model.Count; i++)
    {
        <div class="envelope">
            <!-- Dynamic content inside -->
            @Html.Raw(Model[i])
        </div>
    }
</div>
