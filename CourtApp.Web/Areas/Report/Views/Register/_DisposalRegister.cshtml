 @model IEnumerable<DisposalRegisterViewModel>
<div id="viewAll" class="card-body table-responsive">
    <form asp-controller="Register" method="post" asp-action="UpdateCopyingStatus" class="d-inline">
        <div class="row">
            <div class="col-md-12">
                <table id="tblRegisterDisp" class="table table-striped" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th style="width:5%">Sno.</th>
                            <th style="width:10%">Court.</th>
                            <th style="width:10%">Type</th>
                            <th style="width:10%">No</th>
                            <th style="width:10%">Year</th>
                            <th style="width:20%">Title</th>
                            <th style="width:20%">Dis. Date</th>
                            <th style="width:10%">Remark</th>
                            <th style="width:5%"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int count = 0;
                        }
                        @foreach (var bt in Model)
                        {
                            <tr>
                                <td> @(++count)</td>
                                <td> @bt.Court</td>
                                <td> @bt.CaseType</td>
                                <td> @bt.No</td>
                                <td data-order="@(string.IsNullOrWhiteSpace(bt.Year) ? 0 : Convert.ToInt32(bt.Year))"> @bt.Year</td>
                                <td>@(bt.FirstTitle + " Vs " + bt.SecondTitle)</td>
                                <td data-order="@DateTime.ParseExact(bt.DisposalDate, "dd-MM-yyyy", null).ToString("yyyy-MM-dd")">@bt.DisposalDate</td>
                                <td>@bt.Reason</td>                                
                                <td>
                                    <a onclick="jQueryModalGet('/Litigation/casemanage/OnGetCaseHistory?CaseId=@bt.Id', 'See History')" class="fa fa-history" title="See History"></a>
                                    <a asp-area="Litigation" asp-controller="casemanage" asp-action="GetCaseDetail" asp-route-id="@bt.Id" asp-route-reft="@bt.Reference" class="fa fa-eye" title="View Case Detail"></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>       
    </form>
</div>
<script>
    $(document).ready(function () {
        $("#tblRegisterDisp").DataTable();
    });
</script>