@model List<MultiLangDictViewModel>
@{
    ViewData["Title"] = "Multi-Language Dictionary";
}

<table class="table table-bordered table-hover" id="tblConversionData">
    <thead class="table-dark">
        <tr>
            <th>Keyword (EN)</th>
            <th>Hindi (hi)</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var row in Model)
        {
            var hindiValue = row.Translations.ContainsKey("hi")
            ? row.Translations["hi"]
            : ""; // show blank if no value

            <tr data-id="@row.Id">
                <td>@row.KeyWord</td>
                <td>
                    <input type="text"
                           class="form-control lang-input"
                           data-lang="hi"
                           data-original="@hindiValue"
                           value="@hindiValue" />
                </td>
            </tr>
        }
    </tbody>
</table>

<button id="saveBtn" class="btn btn-success mt-2">Save All</button>
@section Scripts
{

    <script>
                    var table;

        $(document).ready(function () {

            if (!$.fn.DataTable.isDataTable('#tblConversionData')) {
                table = $('#tblConversionData').DataTable({
                    pageLength: 10,
                    stateSave: true,
                    ordering: false
                });
            } else {
                table = $('#tblConversionData').DataTable();
            }

            $('#saveBtn').off('click').on('click', function () {

                var data = [];

                table.rows().every(function () {
                    var row = $(this.node());
                    var id = row.data('id');

                    var input = row.find('.lang-input[data-lang="hi"]');
                    var original = input.data('original') ?? '';
                    var current = input.val() ?? '';

                    if (original !== current) {
                        data.push({
                            id: id,
                            translations: { hi: current }
                        });
                    }
                });

                if (data.length === 0) {
                    Swal.fire({
                        title: "There are no change in the data!",
                        icon: "warning"
                    });
                    return;
                }

                $.ajax({
                    url: '@Url.Action("Save")',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function (response) {

                        Swal.fire({
                            title: response.message,
                            icon: "success"
                        });

                        table.rows().every(function () {
                            var row = $(this.node());
                            row.find('.lang-input[data-lang="hi"]')
                                .data('original', function () {
                                    return $(this).val();
                                });
                        });
                    }
                });
            });
        });
    </script>
}

