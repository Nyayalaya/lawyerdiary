@model IEnumerable<TemplateDlViewModel>
<table id="tblTemplateInfo" class="table table-striped" width="100%" cellspacing="0">
    <thead>
        <tr>
            <th>Sr.</th>
            <th>Template</th>
            @*  <th>Doc</th> *@
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @{
            int count = 0;
        }
        @foreach (var bt in Model)
        {
            <tr>
                <td>
                    @(++count)
                </td>
                <td>
                    @bt.TemplateName
                </td>

                <td>                    
                    <a asp-area="admin" asp-controller="TemplateBuilder" title="Edit the template" asp-action="OnGetCreateOrEdit" asp-route-id="@bt.Id">
                        <i class="fas fa-pencil-alt text-warning"></i>
                    </a>
                    <a title="Map the template dynamic fields" onclick="jQueryModalGet('/Admin/TemplateBuilder/MapFields?id=@bt.Id','Map Form With Template Tags')"><i class="fa fa-map"></i></a>
                </td>

            </tr>
        }
    </tbody>
</table>
<script>
    $(document).ready(function () {
        $("#tblTemplateInfo").DataTable();
    });
</script>